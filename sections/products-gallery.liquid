{{ "header-prime.css" |  asset_url |  stylesheet_tag }}
{{ 'products-gallery.css' | asset_url | stylesheet_tag }}
{{ 'component-swatch.css' | asset_url | stylesheet_tag }}
<script src="{{ 'products-gallery.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px * 0.75);
    padding-bottom: calc({{ section.settings.padding_bottom }}px  * 0.75);
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="section-{{ section.id }}-padding">
  <product-gallery class="product-gallery color-{{ section.settings.color_scheme }}">
    <div class="product-gallery__container page-width">
      <h2 class="product-gallery__heading" {% if section.settings.heading == blank %}hidden{% endif %}>
        {{ section.settings.heading }}
      </h2>
      <div class="product-gallery__grid-wrapper">
        {% for block in section.blocks %}
          {% assign product = block.settings.product %}
          {% if product != blank %}
            {% assign gallery_variant = product.selected_or_first_available_variant %}
            <article class="product-gallery__item" {{ block.shopify_attributes }}>
              <div class="product-gallery__image-wrap">
                {% if product.featured_image != blank %}
                  {{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '360, 540, 720, 960, 1200', sizes: '(min-width: 750px) 33vw, 50vw', class: 'product-gallery__image', alt: product.featured_image.alt | escape }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'product-gallery__image placeholder-svg' }}
                {% endif %}
                <button
                  type="button"
                  class="product-gallery__hotspot"
                  style="--hotspot-x: {{ block.settings.hotspot_x }}%; --hotspot-y: {{ block.settings.hotspot_y }}%;"
                  aria-label="View {{ product.title | escape }}"
                  data-gallery-open="gallery-modal-{{ section.id }}-{{ block.id }}"
                >
                  <span aria-hidden="true">+</span>
                </button>
              </div>
            </article>

            <div class="product-gallery__modal" id="gallery-modal-{{ section.id }}-{{ block.id }}" hidden>
              <div class="product-gallery__modal-backdrop" data-gallery-close></div>
              <div class="product-gallery__dialog" role="dialog" aria-modal="true" aria-labelledby="gallery-title-{{ section.id }}-{{ block.id }}" tabindex="-1">
                <button type="button" class="product-gallery__close" aria-label="Close" data-gallery-close>×</button>
                <div class="product-gallery__modal-product">
                  <div class="product-gallery__modal-image-wrap">
                    {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', class: 'product-gallery__modal-image', alt: product.featured_image.alt | escape }}
                  </div>
                  <div class="product-gallery__details">
                    <h2 id="gallery-title-{{ section.id }}-{{ block.id }}">{{ product.title }}</h2>
                    <div class="product-gallery__price">{{ gallery_variant.price | money }}</div>
                    {% if product.description != blank %}
                      <div class="product-gallery__description">{{ product.description | strip_html }}</div>
                    {% endif %}
                  </div>
                </div>

                {% assign gallery_form_id = 'gallery-form-' | append: section.id | append: '-' | append: block.id %}
                <product-form class="product-form product-gallery__form" data-section-id="{{ section.id }}">
                      <div class="product-form__error-message-wrapper" role="alert" hidden>
                        <span class="product-form__error-message"></span>
                      </div>
                      {%- form 'product', product, id: gallery_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                        <input type="hidden" name="id" value="{{ gallery_variant.id }}" class="product-variant-id">
                        <div class="product-gallery__options" data-variant-picker>
                          {% for option in product.options_with_values %}
                            {% assign option_name = option.name | downcase %}
                            {% if option_name == 'color' or option_name == 'colour' %}
                              {% assign color_option = option %}
                              {% assign color_option_index = forloop.index0 %}
                            {% elsif option_name == 'size' %}
                              {% assign size_option = option %}
                              {% assign size_option_index = forloop.index0 %}
                            {% endif %}
                          {% endfor %}

                          {% if color_option != blank %}
                            <fieldset class="product-gallery__option">
                              <legend>{{ color_option.name }}</legend>
                              <div class="product-gallery__swatches">
                                {% for value in color_option.values %}
                                  <label class="product-gallery__swatch">
                                    <input class="product-gallery__swatch-input" type="radio" name="gallery-option-{{ block.id }}-{{ color_option_index }}" value="{{ value | escape }}" {% if value == color_option.selected_value %}checked{% endif %} data-option-index="{{ color_option_index }}">
                                    <span class="product-gallery__swatch-content">
                                      {% render 'swatch', swatch: value.swatch, shape: 'square' %}
                                      <span class="product-gallery__swatch-name">{{ value }}</span>
                                    </span>
                                  </label>
                                {% endfor %}
                              </div>
                            </fieldset>
                          {% endif %}

                          {% if size_option != blank %}
                            <div class="product-gallery__option">
                              <label for="gallery-option-{{ section.id }}-{{ block.id }}-{{ size_option_index }}">{{ size_option.name }}</label>
                              <div class="product-gallery__select-wrap">
                                <select id="gallery-option-{{ section.id }}-{{ block.id }}-{{ size_option_index }}" name="gallery-option-{{ block.id }}-{{ size_option_index }}" data-option-index="{{ size_option_index }}">
                                  <option value="" selected disabled>Choose your size</option>
                                  {% for value in size_option.values %}<option value="{{ value | escape }}">{{ value }}</option>{% endfor %}
                                </select>
                                <span aria-hidden="true">⌄</span>
                              </div>
                            </div>
                          {% endif %}
                        </div>
                        <div class="product-form__buttons">
                          <button type="submit" name="add" class="product-form__submit button button--primary button--full-width" {% unless gallery_variant.available %}disabled{% endunless %}>
                            <span>{% if gallery_variant.available %}Add to cart{% else %}Sold out{% endif %}</span>
                            {%- render 'loading-spinner' -%}
                          </button>
                        </div>
                        <script type="application/json" data-gallery-variants>{{ product.variants | json }}</script>
                      {%- endform -%}
                </product-form>
              </div>
          </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </product-gallery>
</div>
{% schema %}
{
  "name": "Product Gallery",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "Product Gallery"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "range", "id": "hotspot_x", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Plus icon horizontal position", "default": 50 },
        { "type": "range", "id": "hotspot_y", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Plus icon vertical position", "default": 50 }
      ]
    }
  ]
}
{% endschema %}
